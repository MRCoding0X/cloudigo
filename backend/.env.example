APP_ENV=development
PORT=8080

# postgres://<user>:<password>@<host>:5432/<database>?sslmode=disable
# OBS: specialtecken i lösenordet (t.ex. @) måste URL-encodas.
DATABASE_URL=postgres://postgres:password@localhost:5432/cloudigo_dev?sslmode=disable

STORAGE_PATH=./storage
FRONTEND_URL=http://localhost:3000

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

CLEANUP_INTERVAL_MIN=15

# SMTP is configured via the admin panel (Settings > Mail), stored in the
# database — not here. See internal/service/email_service.go.
